# SIW Intent Brain - Environment Variables Example
# Copy this file to .env and fill in your values

# Required: Your OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Model to use (default: anthropic/claude-sonnet-4)
# SIW_MODEL=anthropic/claude-sonnet-4

# Optional: Request timeout in seconds (default: 30)
# SIW_TIMEOUT_S=30

# Optional: Maximum retry attempts (default: 3)
# SIW_MAX_RETRIES=3

# Optional: Minimum confidence threshold (default: 0.35)
# SIW_MIN_CONFIDENCE=0.35
